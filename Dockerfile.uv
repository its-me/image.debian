FROM ghcr.io/its-me/debian:latest AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

# Always build from the source tarball of the latest release, not a git clone,
# so the build is pinned to an immutable, tagged release artifact.
RUN tag=$(curl --proto '=https' --tlsv1.2 -fsSL https://api.github.com/repos/astral-sh/uv/releases/latest \
        | grep -m1 '"tag_name"' | sed -E 's/.*"tag_name": *"([^"]+)".*/\1/'); \
    curl --proto '=https' --tlsv1.2 -fsSL \
        "https://github.com/astral-sh/uv/releases/download/${tag}/source.tar.gz" \
        -o /tmp/uv-src.tar.gz; \
    mkdir -p /src/uv && tar -xzf /tmp/uv-src.tar.gz -C /src/uv --strip-components=1; \
    rm -f /tmp/uv-src.tar.gz

WORKDIR /src/uv
RUN cargo build --release --locked -p uv


FROM ghcr.io/its-me/debian:python

ARG VERSION
LABEL org.opencontainers.image.version=$VERSION
LABEL org.opencontainers.image.source=https://github.com/its-me/image.debian
LABEL org.opencontainers.image.title="debian-uv"
LABEL org.opencontainers.image.description="Extends the debian-python image with uv, built from the latest release's source tarball against a Rust toolchain in a separate builder stage"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.authors="Sergey Kanafyev <sergeykanafyev@gmail.com>"
LABEL org.opencontainers.image.base.name="ghcr.io/its-me/debian:python"

COPY --from=builder /src/uv/target/release/uv /usr/local/bin/uv

RUN uv --version

CMD ["uv"]
