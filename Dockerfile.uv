FROM ghcr.io/its-me/debian:latest AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

ARG UV_VERSION=latest
RUN if [ "$UV_VERSION" = "latest" ]; then \
        git clone --depth 1 https://github.com/astral-sh/uv.git /src/uv; \
    else \
        git clone --depth 1 --branch "$UV_VERSION" https://github.com/astral-sh/uv.git /src/uv; \
    fi

WORKDIR /src/uv
RUN cargo build --release --locked -p uv


FROM ghcr.io/its-me/debian:python

ARG VERSION
LABEL org.opencontainers.image.version=$VERSION
LABEL org.opencontainers.image.source=https://github.com/its-me/image.debian
LABEL org.opencontainers.image.title="debian-uv"
LABEL org.opencontainers.image.description="Extends the debian-python image with uv, built from source against a Rust toolchain in a separate builder stage"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.authors="Sergey Kanafyev <sergeykanafyev@gmail.com>"
LABEL org.opencontainers.image.base.name="ghcr.io/its-me/debian:python"

COPY --from=builder /src/uv/target/release/uv /usr/local/bin/uv

RUN uv --version

CMD ["uv"]
